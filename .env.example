# Copy this file to ".env" and fill in your values. Never share or upload .env publicly.

# Password for /admin.html
ADMIN_KEY=change-me

# Your site address (used for Cryptomus return links and webhook)
PUBLIC_URL=https://pixelsub.shop

# Binance API key used ONLY to read Binance Pay history and auto-verify payments.
# binance.com > Profile > API Management: "Enable Reading" ONLY (no trading, no withdrawals), restrict to your server IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API key used ONLY to read incoming internal (UID) transfers.
# bybit.com > Profile > API: System-generated key, "Read-Only", permission Assets > Wallet/Exchange history, restrict to your server IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Cryptomus merchant: app.cryptomus.com > Merchant > Settings > API integration (Payment API key)
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

# Supplier: TokoPremium reseller API key (tokopremium.digital → My account → Reseller & API).
# tpk_test_... = test data, tpk_live_... = real orders paid from your TokoPremium balance.
TOKOPREMIUM_API_KEY=

# PORT=5173
